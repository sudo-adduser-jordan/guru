"

QA_FLAGS_IGNORED="usr/libexec/wattseal/wattseal"

DOCS=( README.md )

src_install() {
	cargo_src_install
	einstalldocs

	# Upstream names the binary with a capital W; install it under the
	# conventional lowercase name instead, in libexec: the program
	# chdirs to its own location on startup and keeps its database and
	# log next to the working directory, so running it straight from
	# read-only /usr/bin would fail silently. /usr/bin/wattseal is a
	# wrapper that runs a per-user copy from a writable data dir.
	mkdir -p "${ED}/usr/libexec/wattseal" || die
	mv "${ED}/usr/bin/WattSeal" "${ED}/usr/libexec/wattseal/wattseal" || die

	cat > "${T}/wattseal" <<-EOF || die
		#!/bin/sh
		data_dir="\${XDG_DATA_HOME:-\$HOME/.local/share}/wattseal"
		mkdir -p "\${data_dir}" || exit 1
		installed="${EPREFIX}/usr/libexec/wattseal/wattseal"
		local_copy="\${data_dir}/wattseal"
		if [ ! -x "\${local_copy}" ] || [ "\${installed}" -nt "\${local_copy}" ]; then
			cp -f "\${installed}" "\${local_copy}" || exit 1
			chmod +x "\${local_copy}" || exit 1
		fi
		cd "\${data_dir}" || exit 1
		exec "\${local_copy}" "\$@"
	EOF
	newbin "${T}/wattseal" wattseal

	sed -e 's/^Exec=WattSeal$/Exec=wattseal/' \
		-e 's/^Icon=WattSeal$/Icon=wattseal/' \
		resources/linux/WattSeal.desktop > "${T}/wattseal.desktop" || die
	domenu "${T}/wattseal.desktop"
	newicon resources/icon.png wattseal.png
}

pkg_postinst() {
	xdg_pkg_postinst
	elog "WattSeal stores its database and log in ~/.local/share/wattseal."
	elog "Launch the UI with: wattseal --ui"
}

pkg_postrm() {
	xdg_pkg_postrm
}
