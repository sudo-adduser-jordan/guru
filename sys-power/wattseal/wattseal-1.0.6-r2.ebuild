inherit cargo desktop xdg

DESCRIPTION="Real-time PC power consumption monitor, per-app and per-component"
HOMEPAGE="https://wattseal.com/"
SRC_URI="
	https://github.com/Daminoup88/WattSeal/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"
# Upstream tarball extracts to WattSeal-${PV} (capital W/S).
S="${WORKDIR}/WattSeal-${PV}"

LICENSE="GPL-3"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC0-1.0 ISC MIT MPL-2.0 UoI-NCSA Unicode-3.0 ZLIB
"
