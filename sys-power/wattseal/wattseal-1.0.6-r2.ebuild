KEYWORDS="~amd64"

# Upstream .cargo/config.toml forces panic=abort, which is incompatible
# with the test harness, so tests cannot run.
RESTRICT="test"

DEPEND="
	app-accessibility/at-spi2-core:2
	dev-libs/expat
	dev-libs/glib:2
	dev-libs/wayland
	media-libs/fontconfig
